{
  "name": "@cremona/core",
  "version": "0.1.0",
  "description": "Cremona framework-agnostic runtime — types, isometric helpers, shared constants.",
  "license": "MIT",
  "author": "Sébastien Dieunidou",
  "homepage": "https://github.com/sdieunidou/cremona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdieunidou/cremona.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sdieunidou/cremona/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
