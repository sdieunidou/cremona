{
  "name": "@cremona/ui",
  "version": "0.1.0",
  "description": "Cremona UI — accessible, responsive React components on the Cremona tokens: import them from npm, or copy their source into an app with the shadcn CLI.",
  "license": "MIT",
  "author": "Sébastien Dieunidou",
  "homepage": "https://github.com/sdieunidou/cremona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdieunidou/cremona.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/sdieunidou/cremona/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "accessible",
    "tailwindcss",
    "shadcn",
    "radix",
    "design-system"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./registry.json": "./registry.json",
    "./utils": "./src/utils.ts",
    "./*": "./src/*.tsx"
  },
  "files": [
    "dist",
    "r",
    "registry.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./registry.json": "./registry.json",
      "./utils": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "typesVersions": {
      "*": {
        "package.json": [
          "./package.json"
        ],
        "utils": [
          "./dist/utils.d.ts"
        ],
        "*": [
          "./dist/*.d.ts"
        ]
      }
    }
  }
}
