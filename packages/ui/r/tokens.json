{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tokens",
  "type": "registry:theme",
  "title": "Cremona tokens",
  "description": "The status tokens (success, warning, info) and the destructive foreground that the Cremona components use, in light and dark. The shadcn tokens they sit next to are untouched.",
  "cssVars": {
    "theme": {
      "color-success": "var(--success)",
      "color-success-foreground": "var(--success-foreground)",
      "color-warning": "var(--warning)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-info": "var(--info)",
      "color-info-foreground": "var(--info-foreground)",
      "color-destructive-foreground": "var(--destructive-foreground)"
    },
    "light": {
      "success": "oklch(50.4% .138 150.069)",
      "success-foreground": "oklch(98.5% 0 0)",
      "warning": "oklch(53.2% .142 48.998)",
      "warning-foreground": "oklch(98.5% 0 0)",
      "info": "oklch(48.8% .243 264.376)",
      "info-foreground": "oklch(98.5% 0 0)",
      "destructive-foreground": "oklch(98.5% 0 0)"
    },
    "dark": {
      "success": "oklch(79.2% .209 151.711)",
      "success-foreground": "oklch(20.5% 0 0)",
      "warning": "oklch(82.8% .189 84.429)",
      "warning-foreground": "oklch(20.5% 0 0)",
      "info": "oklch(70.7% .165 254.624)",
      "info-foreground": "oklch(20.5% 0 0)",
      "destructive-foreground": "oklch(20.5% 0 0)"
    }
  },
  "categories": [
    "tokens"
  ]
}
