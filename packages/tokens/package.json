{
  "name": "@cremona/tokens",
  "version": "0.1.0",
  "description": "Cremona design tokens — themes (light/dark), palette, fonts, keyframes.",
  "license": "MIT AND OFL-1.1",
  "author": "Sébastien Dieunidou",
  "homepage": "https://github.com/sdieunidou/cremona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdieunidou/cremona.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/sdieunidou/cremona/issues"
  },
  "type": "module",
  "exports": {
    "./css": "./css/cremona.css",
    "./css/cremona.css": "./css/cremona.css",
    "./css/themes.css": "./css/themes.css",
    "./themes.json": "./themes.json",
    "./package.json": "./package.json"
  },
  "style": "./css/cremona.css",
  "files": [
    "css",
    "themes.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:css": "tailwindcss -i src/cremona.css -o css/cremona.css --minify",
    "test": "vitest run",
    "typecheck": "true"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
