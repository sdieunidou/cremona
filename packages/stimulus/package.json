{
  "name": "@cremona/stimulus",
  "version": "0.1.0",
  "description": "Cremona Stimulus adapter — controllers and static templates for Symfony apps.",
  "license": "MIT",
  "author": "Sébastien Dieunidou",
  "homepage": "https://github.com/sdieunidou/cremona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdieunidou/cremona.git",
    "directory": "packages/stimulus"
  },
  "bugs": {
    "url": "https://github.com/sdieunidou/cremona/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./controllers/cremona-visual": {
      "types": "./src/cremona-visual_controller.d.ts",
      "default": "./src/cremona-visual_controller.js"
    },
    "./controllers/cremona-theme": {
      "types": "./src/cremona-theme_controller.d.ts",
      "default": "./src/cremona-theme_controller.js"
    },
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "templates"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.2"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
