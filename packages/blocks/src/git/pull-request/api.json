{
  "component": "PullRequest",
  "props": [
    {
      "name": "variant",
      "type": "\"passing\" | \"failing\"",
      "optional": true,
      "default": "\"passing\""
    },
    {
      "name": "title",
      "type": "string",
      "optional": true,
      "default": "\"Add Stripe checkout flow\""
    },
    { "name": "number", "type": "string", "optional": true, "default": "\"#482\"" },
    { "name": "source", "type": "string", "optional": true, "default": "\"feat/checkout\"" },
    { "name": "target", "type": "string", "optional": true, "default": "\"main\"" },
    { "name": "files", "type": "number", "optional": true, "default": "8" },
    { "name": "additions", "type": "number", "optional": true, "default": "214" },
    { "name": "deletions", "type": "number", "optional": true, "default": "36" },
    { "name": "checks", "type": "PullRequestCheck[]", "optional": true },
    { "name": "reviewer", "type": "string", "optional": true, "default": "\"Emma Wallace\"" },
    { "name": "reviewerImage", "type": "string", "optional": true },
    { "name": "status", "type": "string", "optional": true, "default": "\"Open\"" },
    { "name": "mergeLabel", "type": "string", "optional": true },
    {
      "name": "labels",
      "type": "Partial<PullRequestLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "locale",
      "type": "string",
      "optional": true,
      "description": "BCP 47 locale of the file count's plural (default `\"en-US\"`).",
      "default": "\"en-US\""
    },
    { "name": "hover", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "PullRequestCheck",
      "props": [
        { "name": "name", "type": "string", "optional": false },
        { "name": "duration", "type": "string", "optional": false }
      ]
    },
    {
      "name": "PullRequestLabels",
      "props": [
        {
          "name": "checksQueued",
          "type": "string",
          "optional": false,
          "description": "Footer while no check has started."
        },
        {
          "name": "checksRunning",
          "type": "string",
          "optional": false,
          "description": "Footer while a check runs."
        },
        {
          "name": "checksFailed",
          "type": "string",
          "optional": false,
          "description": "Footer of the failing variant once the checks are done."
        },
        {
          "name": "approved",
          "type": "string",
          "optional": false,
          "description": "Footer of the passing variant once the checks are done; `{reviewer}` is replaced."
        },
        {
          "name": "files",
          "type": "string",
          "optional": false,
          "description": "Changed files; `{count}` is replaced."
        },
        {
          "name": "filesOne",
          "type": "string",
          "optional": false,
          "description": "`files` when the count is one."
        }
      ]
    }
  ]
}
