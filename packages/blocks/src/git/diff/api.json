{
  "component": "Diff",
  "props": [
    {
      "name": "view",
      "type": "\"unified\" | \"split\"",
      "optional": true,
      "default": "\"unified\""
    },
    {
      "name": "file",
      "type": "string",
      "optional": true,
      "default": "\"src/checkout/session.ts\""
    },
    { "name": "language", "type": "string", "optional": true, "default": "\"TS\"" },
    { "name": "hunk", "type": "string", "optional": true, "default": "\"@@ -14,7 +14,9 @@\"" },
    { "name": "startLine", "type": "number", "optional": true, "default": "14" },
    { "name": "lines", "type": "DiffLine[]", "optional": true },
    { "name": "lineNumbers", "type": "boolean", "optional": true, "default": "true" },
    { "name": "hover", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "DiffLine",
      "props": [
        { "name": "type", "type": "\"add\" | \"remove\"", "optional": true },
        { "name": "indent", "type": "number", "optional": true },
        { "name": "tokens", "type": "DiffToken[]", "optional": false }
      ]
    },
    {
      "name": "DiffToken",
      "props": [
        { "name": "width", "type": "number", "optional": false },
        { "name": "color", "type": "TokenColor", "optional": false }
      ]
    },
    {
      "name": "TokenColor",
      "type": "\"keyword\" | \"func\" | \"string\" | \"variable\" | \"type\" | \"punct\" | \"tag\" | \"prop\" | \"comment\""
    }
  ]
}
