{
  "component": "Heatmap",
  "props": [
    { "name": "title", "type": "string", "optional": true, "default": "\"Active hours\"" },
    { "name": "badge", "type": "string", "optional": true, "default": "\"4w\"" },
    { "name": "value", "type": "string", "optional": true, "default": "\"12.4k\"" },
    { "name": "change", "type": "string", "optional": true, "default": "\"+9.2%\"" },
    {
      "name": "positive",
      "type": "\"up\" | \"down\"",
      "optional": true,
      "description": "Which way of `change` is good news, coloured green (default \"up\"; \"down\" for churn, latency…).",
      "default": "\"up\""
    },
    {
      "name": "rows",
      "type": "readonly HeatmapRow[]",
      "optional": true,
      "default": "[…] (7 items)"
    },
    {
      "name": "columns",
      "type": "readonly string[]",
      "optional": true,
      "default": "[…] (12 items)"
    },
    { "name": "color", "type": "string", "optional": true, "default": "\"var(--color-primary)\"" },
    { "name": "legend", "type": "boolean", "optional": true, "default": "true" },
    { "name": "legendLow", "type": "string", "optional": true, "default": "\"Less\"" },
    { "name": "legendHigh", "type": "string", "optional": true, "default": "\"More\"" },
    {
      "name": "emptyLabel",
      "type": "string",
      "optional": true,
      "description": "Shown in place of the grid when there is no row or column.",
      "default": "\"No data\""
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "HeatmapRow",
      "props": [
        { "name": "label", "type": "string", "optional": false },
        {
          "name": "values",
          "type": "readonly number[]",
          "optional": false,
          "description": "One value per column; a missing column reads 0, a non-finite value draws an empty cell."
        }
      ]
    }
  ]
}
