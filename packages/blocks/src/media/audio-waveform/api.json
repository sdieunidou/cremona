{
  "component": "AudioWaveform",
  "props": [
    {
      "name": "icon",
      "type": "ReactNode",
      "optional": true,
      "default": "<Music className=\"size-4\" />"
    },
    { "name": "title", "type": "string", "optional": true, "default": "\"Midnight in Lisbon\"" },
    {
      "name": "subtitle",
      "type": "string",
      "optional": true,
      "default": "\"Léo Marques · Single\""
    },
    { "name": "current", "type": "string", "optional": true, "default": "\"1:42\"" },
    { "name": "duration", "type": "string", "optional": true, "default": "\"3:28\"" },
    { "name": "progress", "type": "number", "optional": true, "default": "48" },
    { "name": "state", "type": "\"play\" | \"pause\"", "optional": true, "default": "\"play\"" },
    { "name": "hint", "type": "string", "optional": true },
    { "name": "meta", "type": "string", "optional": true, "default": "\"Hi-Fi · 320kbps\"" },
    { "name": "bars", "type": "number", "optional": true, "default": "36" },
    {
      "name": "labels",
      "type": "Partial<AudioWaveformLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "AudioWaveformLabels",
      "props": [
        {
          "name": "play",
          "type": "string",
          "optional": false,
          "description": "Name of the play/pause button, by the action it shows."
        },
        { "name": "pause", "type": "string", "optional": false },
        {
          "name": "playHint",
          "type": "string",
          "optional": false,
          "description": "Hint under the waveform when `hint` is not set, by the action the button shows."
        },
        { "name": "pauseHint", "type": "string", "optional": false }
      ]
    }
  ]
}
