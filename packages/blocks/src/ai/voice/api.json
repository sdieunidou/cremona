{
  "component": "Voice",
  "props": [
    { "name": "state", "type": "VoiceState", "optional": true },
    { "name": "transcript", "type": "string", "optional": true },
    { "name": "listeningTranscript", "type": "string", "optional": true },
    { "name": "speakingTranscript", "type": "string", "optional": true },
    { "name": "status", "type": "string", "optional": true },
    { "name": "listeningStatus", "type": "string", "optional": true },
    { "name": "thinkingStatus", "type": "string", "optional": true },
    { "name": "speakingStatus", "type": "string", "optional": true },
    { "name": "hover", "type": "boolean", "optional": true, "default": "false" },
    { "name": "glow", "type": "boolean", "optional": true, "default": "true" },
    { "name": "particles", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [{ "name": "VoiceState", "type": "\"listening\" | \"thinking\" | \"speaking\"" }]
}
