{
  "component": "Kbd",
  "props": [
    { "name": "keys", "type": "string[]", "optional": true, "default": "[…] (1 items)" },
    {
      "name": "caption",
      "type": "string",
      "optional": true,
      "description": "Text under the keys (\"\" hides it; default: a caption for the demo shortcuts)."
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Stays centred in the box.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": []
}
