{
  "component": "Pagination",
  "props": [
    { "name": "page", "type": "number", "optional": true, "default": "2" },
    { "name": "total", "type": "number", "optional": true, "default": "9" },
    {
      "name": "labels",
      "type": "Partial<PaginationLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "compact", "type": "boolean", "optional": true, "default": "false" },
    { "name": "rounded", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Full width, at the top of the box.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "PaginationLabels",
      "props": [
        {
          "name": "navigation",
          "type": "string",
          "optional": false,
          "description": "Accessible name of the navigation landmark."
        },
        {
          "name": "previous",
          "type": "string",
          "optional": false,
          "description": "Accessible names of the arrow buttons."
        },
        { "name": "next", "type": "string", "optional": false },
        {
          "name": "page",
          "type": "string",
          "optional": false,
          "description": "Status of the compact layout; `{page}` (emphasized) and `{total}` are replaced."
        }
      ]
    }
  ]
}
