{
  "component": "Skeleton",
  "props": [
    {
      "name": "layout",
      "type": "\"text\" | \"avatar\" | \"media\" | \"card\"",
      "optional": true,
      "default": "\"text\""
    },
    {
      "name": "lines",
      "type": "number",
      "optional": true,
      "description": "Number of bars in the text layout.",
      "default": "4"
    },
    {
      "name": "label",
      "type": "string",
      "optional": true,
      "description": "Text read by screen readers.",
      "default": "\"Loading…\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Full width; the card layout also takes the full height.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": []
}
