{
  "component": "Input",
  "props": [
    {
      "name": "type",
      "type": "\"text\" | \"email\" | \"password\" | \"search\"",
      "optional": true,
      "default": "\"text\""
    },
    { "name": "label", "type": "string", "optional": true, "default": "\"Project name\"" },
    { "name": "placeholder", "type": "string", "optional": true, "default": "\"Acme Inc.\"" },
    { "name": "hint", "type": "string", "optional": true },
    { "name": "invalid", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "errorText",
      "type": "string",
      "optional": true,
      "default": "\"This name is already taken.\""
    },
    { "name": "disabled", "type": "boolean", "optional": true, "default": "false" },
    { "name": "defaultValue", "type": "string", "optional": true, "default": "\"\"" },
    {
      "name": "labels",
      "type": "Partial<InputLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Full width, at the top of the box.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "InputLabels",
      "props": [
        {
          "name": "showPassword",
          "type": "string",
          "optional": false,
          "description": "Accessible name of the password visibility toggle (its state is `aria-pressed`)."
        }
      ]
    }
  ]
}
