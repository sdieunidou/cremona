{
  "component": "Checkbox",
  "props": [
    {
      "name": "checked",
      "type": "boolean | \"indeterminate\"",
      "optional": true,
      "description": "State on first render; clicking toggles it.",
      "default": "false"
    },
    { "name": "label", "type": "string", "optional": true, "default": "\"Accept terms\"" },
    {
      "name": "description",
      "type": "string",
      "optional": true,
      "default": "\"Unlimited projects and priority support.\""
    },
    {
      "name": "mixed",
      "type": "boolean",
      "optional": true,
      "deprecated": true,
      "default": "false"
    },
    {
      "name": "card",
      "type": "boolean",
      "optional": true,
      "description": "Selectable card with a description.",
      "default": "false"
    },
    { "name": "disabled", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "At the top of the box; the card variant takes its full width and height.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": []
}
