{
  "component": "Accordion",
  "props": [
    {
      "name": "count",
      "type": "number",
      "optional": true,
      "description": "Number of items shown (default 3)."
    },
    {
      "name": "icons",
      "type": "boolean",
      "optional": true,
      "description": "Show a leading icon per item.",
      "default": "false"
    },
    {
      "name": "items",
      "type": "AccordionItem[]",
      "optional": true,
      "description": "The items (default: a billing FAQ)."
    },
    {
      "name": "active",
      "type": "number",
      "optional": true,
      "description": "Index of the item open on first render (-1: none).",
      "default": "0"
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Full width and height of the box.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "AccordionItem",
      "props": [
        { "name": "title", "type": "string", "optional": false },
        { "name": "content", "type": "string", "optional": false },
        { "name": "icon", "type": "LucideIcon", "optional": true }
      ]
    }
  ]
}
