{
  "component": "Alert",
  "props": [
    {
      "name": "variant",
      "type": "\"info\" | \"success\" | \"warning\" | \"destructive\"",
      "optional": true,
      "default": "\"info\""
    },
    { "name": "title", "type": "string", "optional": true },
    { "name": "description", "type": "string", "optional": true },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "description": "Full width, at the top of the box.",
      "default": "false"
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": []
}
