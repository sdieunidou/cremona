{
  "component": "Editor",
  "props": [
    { "name": "language", "type": "EditorLanguage", "optional": true, "default": "\"tsx\"" },
    { "name": "tabs", "type": "readonly EditorTab[]", "optional": true },
    { "name": "lines", "type": "readonly EditorLine[]", "optional": true },
    { "name": "lineNumbers", "type": "boolean", "optional": true, "default": "true" },
    { "name": "caret", "type": "boolean", "optional": true, "default": "true" },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "EditorLanguage",
      "type": "\"tsx\" | \"js\" | \"py\" | \"php\" | \"html\" | \"css\" | \"go\""
    },
    {
      "name": "EditorLine",
      "props": [
        { "name": "indent", "type": "number", "optional": false },
        { "name": "tokens", "type": "readonly EditorToken[]", "optional": false },
        { "name": "blank", "type": "boolean", "optional": true },
        { "name": "highlight", "type": "boolean", "optional": true },
        { "name": "diff", "type": "\"add\" | \"remove\"", "optional": true }
      ]
    },
    {
      "name": "EditorTab",
      "props": [
        { "name": "name", "type": "string", "optional": false },
        { "name": "active", "type": "boolean", "optional": true }
      ]
    },
    {
      "name": "EditorToken",
      "props": [
        { "name": "width", "type": "number", "optional": false },
        {
          "name": "color",
          "type": "\"keyword\" | \"func\" | \"string\" | \"variable\" | \"type\" | \"comment\" | \"punct\" | \"tag\" | \"prop\"",
          "optional": false
        }
      ]
    }
  ]
}
