{
  "component": "Logs",
  "props": [
    {
      "name": "variant",
      "type": "\"api\" | \"worker\" | \"errors\"",
      "optional": true,
      "default": "\"api\""
    },
    { "name": "service", "type": "string", "optional": true },
    { "name": "lines", "type": "readonly LogLine[]", "optional": true },
    {
      "name": "sources",
      "type": "readonly ReactNode[]",
      "optional": true,
      "default": "[…] (3 items)"
    },
    { "name": "pulse", "type": "\"dot\" | \"line\"", "optional": true, "default": "\"dot\"" },
    {
      "name": "labels",
      "type": "Partial<LogsLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "hover", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    { "name": "LogLevel", "type": "\"info\" | \"warn\" | \"error\" | \"debug\" | \"success\"" },
    {
      "name": "LogLine",
      "props": [
        { "name": "time", "type": "string", "optional": false },
        { "name": "level", "type": "LogLevel", "optional": false },
        { "name": "message", "type": "string", "optional": false }
      ]
    },
    {
      "name": "LogsLabels",
      "props": [
        { "name": "info", "type": "string", "optional": false },
        { "name": "warn", "type": "string", "optional": false },
        { "name": "error", "type": "string", "optional": false },
        { "name": "debug", "type": "string", "optional": false },
        { "name": "success", "type": "string", "optional": false }
      ]
    }
  ]
}
