{
  "component": "Filters",
  "props": [
    { "name": "title", "type": "string", "optional": true, "default": "\"Filters\"" },
    { "name": "unit", "type": "string", "optional": true, "default": "\"customers\"" },
    { "name": "total", "type": "number", "optional": true, "default": "2480" },
    {
      "name": "rules",
      "type": "readonly FilterRule[]",
      "optional": true,
      "default": "[…] (4 items)"
    },
    { "name": "addLabel", "type": "string", "optional": true, "default": "\"Add filter\"" },
    {
      "name": "emptyLabel",
      "type": "string",
      "optional": true,
      "description": "Shown in place of the rules when `rules` is empty.",
      "default": "\"No filters\""
    },
    {
      "name": "labels",
      "type": "Partial<FiltersLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "locale",
      "type": "string",
      "optional": true,
      "description": "BCP 47 locale of the counts (default `\"en-US\"`).",
      "default": "\"en-US\""
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "FilterRule",
      "props": [
        { "name": "field", "type": "string", "optional": false },
        { "name": "operator", "type": "string", "optional": false },
        { "name": "value", "type": "string", "optional": false },
        { "name": "matches", "type": "number", "optional": false }
      ]
    },
    {
      "name": "FiltersLabels",
      "props": [
        {
          "name": "where",
          "type": "string",
          "optional": false,
          "description": "Before the first rule."
        },
        {
          "name": "and",
          "type": "string",
          "optional": false,
          "description": "Before each following rule."
        },
        { "name": "clear", "type": "string", "optional": false },
        {
          "name": "of",
          "type": "string",
          "optional": false,
          "description": "After the match count; `{total}` and `{unit}` are replaced."
        }
      ]
    }
  ]
}
