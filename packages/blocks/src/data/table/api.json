{
  "component": "Table",
  "props": [
    { "name": "title", "type": "string", "optional": true, "default": "\"Members\"" },
    {
      "name": "columns",
      "type": "readonly TableColumn[]",
      "optional": true,
      "default": "[…] (4 items)"
    },
    {
      "name": "items",
      "type": "readonly TableRowItem[]",
      "optional": true,
      "default": "[…] (4 items)"
    },
    {
      "name": "emptyLabel",
      "type": "string",
      "optional": true,
      "description": "Shown in the table body when `items` is empty.",
      "default": "\"No rows\""
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "TableColumn",
      "props": [
        { "name": "label", "type": "string", "optional": false },
        { "name": "key", "type": "string", "optional": false },
        { "name": "avatar", "type": "boolean", "optional": true },
        { "name": "badge", "type": "boolean", "optional": true },
        { "name": "sort", "type": "boolean", "optional": true }
      ]
    },
    {
      "name": "TableRowItem",
      "props": [
        { "name": "name", "type": "string", "optional": false },
        { "name": "initials", "type": "string", "optional": true },
        { "name": "subtitle", "type": "string", "optional": true },
        { "name": "status", "type": "string", "optional": true }
      ]
    }
  ]
}
