{
  "component": "Query",
  "props": [
    { "name": "source", "type": "string", "optional": true, "default": "\"orders\"" },
    { "name": "duration", "type": "string", "optional": true, "default": "\"24 ms\"" },
    {
      "name": "conditions",
      "type": "readonly QueryCondition[]",
      "optional": true,
      "default": "[…] (2 items)"
    },
    {
      "name": "columns",
      "type": "readonly string[]",
      "optional": true,
      "default": "[…] (3 items)"
    },
    {
      "name": "rows",
      "type": "readonly (readonly string[])[]",
      "optional": true,
      "default": "[…] (4 items)"
    },
    {
      "name": "emptyLabel",
      "type": "string",
      "optional": true,
      "description": "Shown in the results table when `rows` is empty.",
      "default": "\"No rows\""
    },
    {
      "name": "labels",
      "type": "Partial<QueryLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "locale",
      "type": "string",
      "optional": true,
      "description": "BCP 47 locale of the row count (default `\"en-US\"`).",
      "default": "\"en-US\""
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "QueryCondition",
      "props": [
        { "name": "field", "type": "string", "optional": false },
        { "name": "operator", "type": "string", "optional": false },
        { "name": "value", "type": "string", "optional": false }
      ]
    },
    {
      "name": "QueryLabels",
      "props": [
        {
          "name": "from",
          "type": "string",
          "optional": false,
          "description": "Before the source name."
        },
        { "name": "run", "type": "string", "optional": false },
        {
          "name": "where",
          "type": "string",
          "optional": false,
          "description": "Before the first condition."
        },
        {
          "name": "and",
          "type": "string",
          "optional": false,
          "description": "Before each following condition."
        },
        {
          "name": "rows",
          "type": "string",
          "optional": false,
          "description": "Result count; `{count}` is replaced by the number of rows."
        },
        {
          "name": "rowsOne",
          "type": "string",
          "optional": false,
          "description": "`rows` when the count is one."
        }
      ]
    }
  ]
}
