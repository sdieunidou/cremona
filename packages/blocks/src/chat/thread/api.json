{
  "component": "Thread",
  "props": [
    { "name": "parentUser", "type": "string", "optional": true, "default": "\"Alex Park\"" },
    { "name": "parentInitials", "type": "string", "optional": true, "default": "\"AP\"" },
    { "name": "parentTime", "type": "string", "optional": true, "default": "\"10:24 AM\"" },
    {
      "name": "parentText",
      "type": "string",
      "optional": true,
      "default": "\"Just shipped the new onboarding flow. Conversion is alread…"
    },
    {
      "name": "replies",
      "type": "readonly ThreadReply[]",
      "optional": true,
      "default": "[…] (2 items)"
    },
    { "name": "likes", "type": "number", "optional": true, "default": "24" },
    { "name": "actions", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "labels",
      "type": "Partial<ThreadLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "ThreadLabels",
      "props": [
        {
          "name": "placeholder",
          "type": "string",
          "optional": false,
          "description": "Text of the empty reply box."
        }
      ]
    },
    {
      "name": "ThreadReply",
      "props": [
        { "name": "user", "type": "string", "optional": false },
        { "name": "initials", "type": "string", "optional": false },
        { "name": "text", "type": "string", "optional": false },
        { "name": "time", "type": "string", "optional": false }
      ]
    }
  ]
}
