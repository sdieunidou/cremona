{
  "component": "Compose",
  "props": [
    { "name": "title", "type": "string", "optional": true, "default": "\"New message\"" },
    { "name": "meta", "type": "string", "optional": true },
    { "name": "to", "type": "ComposeRecipient[]", "optional": true, "default": "[…] (1 items)" },
    { "name": "cc", "type": "ComposeRecipient[]", "optional": true },
    { "name": "subject", "type": "string", "optional": true, "default": "\"Q4 roadmap review\"" },
    { "name": "sendLabel", "type": "string", "optional": true, "default": "\"Send\"" },
    {
      "name": "labels",
      "type": "Partial<ComposeLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "ComposeLabels",
      "props": [
        { "name": "to", "type": "string", "optional": false, "description": "Field names." },
        { "name": "cc", "type": "string", "optional": false },
        { "name": "subject", "type": "string", "optional": false },
        {
          "name": "remove",
          "type": "string",
          "optional": false,
          "description": "Remove button of a recipient; `{email}` is replaced by the address."
        }
      ]
    },
    {
      "name": "ComposeRecipient",
      "props": [
        { "name": "initials", "type": "string", "optional": false },
        { "name": "email", "type": "string", "optional": false }
      ]
    }
  ]
}
