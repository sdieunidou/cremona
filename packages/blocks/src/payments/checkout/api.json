{
  "component": "Checkout",
  "props": [
    { "name": "amount", "type": "string", "optional": true, "default": "\"$42.00\"" },
    { "name": "buttonLabel", "type": "string", "optional": true, "default": "\"Pay\"" },
    { "name": "name", "type": "string", "optional": true, "default": "\"JOHN T. DOE\"" },
    { "name": "brand", "type": "string", "optional": true, "default": "\"PLATINUM\"" },
    {
      "name": "cardNumber",
      "type": "string",
      "optional": true,
      "default": "\"4242 4242 4242 4242\""
    },
    { "name": "expiry", "type": "string", "optional": true, "default": "\"12/29\"" },
    { "name": "cvc", "type": "string", "optional": true, "default": "\"•••\"" },
    { "name": "card", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "labels",
      "type": "Partial<CheckoutLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "CheckoutLabels",
      "props": [
        {
          "name": "title",
          "type": "string",
          "optional": false,
          "description": "Header of the payment form."
        },
        {
          "name": "secure",
          "type": "string",
          "optional": false,
          "description": "Next to the lock in the header."
        },
        {
          "name": "cardHolder",
          "type": "string",
          "optional": false,
          "description": "Captions on the card face (`card` mode)."
        },
        { "name": "cardExpires", "type": "string", "optional": false },
        {
          "name": "changeCard",
          "type": "string",
          "optional": false,
          "description": "Link under the card (`card` mode)."
        },
        {
          "name": "cardNumber",
          "type": "string",
          "optional": false,
          "description": "Field labels of the form."
        },
        { "name": "expires", "type": "string", "optional": false },
        { "name": "cvc", "type": "string", "optional": false }
      ]
    }
  ]
}
