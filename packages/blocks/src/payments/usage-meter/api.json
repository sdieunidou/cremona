{
  "component": "UsageMeter",
  "props": [
    { "name": "title", "type": "string", "optional": true, "default": "\"Usage this month\"" },
    { "name": "period", "type": "string", "optional": true, "default": "\"18 days left\"" },
    { "name": "meterLabel", "type": "string", "optional": true, "default": "\"API requests\"" },
    { "name": "meterUsage", "type": "string", "optional": true, "default": "\"1.24M / 2M\"" },
    {
      "name": "meterCaption",
      "type": "string",
      "optional": true,
      "default": "\"62% of included quota used\""
    },
    { "name": "usedRatio", "type": "number", "optional": true, "default": "0.62" },
    {
      "name": "items",
      "type": "readonly UsageItem[]",
      "optional": true,
      "default": "[…] (3 items)"
    },
    { "name": "total", "type": "string", "optional": true, "default": "\"$248.60\"" },
    { "name": "totalLabel", "type": "string", "optional": true, "default": "\"Estimated total\"" },
    { "name": "trend", "type": "string", "optional": true, "default": "\"+12%\"" },
    {
      "name": "warnAt",
      "type": "number",
      "optional": true,
      "description": "From this `usedRatio` on, the meter turns to the warning colour (and destructive at 1)."
    },
    { "name": "actionLabel", "type": "string", "optional": true, "default": "\"Manage plan\"" },
    {
      "name": "emptyLabel",
      "type": "string",
      "optional": true,
      "description": "Shown in place of the breakdown when `items` is empty.",
      "default": "\"No usage yet\""
    },
    { "name": "fadeOut", "type": "boolean", "optional": true, "default": "false" },
    { "name": "isometric", "type": "boolean", "optional": true, "default": "false" },
    { "name": "gradient", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "UsageItem",
      "props": [
        { "name": "label", "type": "string", "optional": false },
        { "name": "detail", "type": "string", "optional": false },
        { "name": "amount", "type": "string", "optional": false },
        {
          "name": "color",
          "type": "string",
          "optional": true,
          "description": "Dot colour: a background class (`bg-chart-2`) or any CSS colour."
        }
      ]
    }
  ]
}
