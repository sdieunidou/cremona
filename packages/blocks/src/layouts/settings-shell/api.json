{
  "component": "SettingsShell",
  "props": [
    {
      "name": "danger",
      "type": "boolean",
      "optional": true,
      "description": "Append a destructive \"Delete account\" card above the save bar.",
      "default": "false"
    },
    {
      "name": "labels",
      "type": "Partial<SettingsShellLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "SettingsShellLabels",
      "props": [
        {
          "name": "navigation",
          "type": "string",
          "optional": false,
          "description": "Accessible name of the section list."
        },
        { "name": "settings", "type": "string", "optional": false },
        {
          "name": "general",
          "type": "string",
          "optional": false,
          "description": "Sections; `general` is also the page title."
        },
        { "name": "security", "type": "string", "optional": false },
        { "name": "billing", "type": "string", "optional": false },
        { "name": "notifications", "type": "string", "optional": false },
        { "name": "generalDescription", "type": "string", "optional": false },
        {
          "name": "workspaceName",
          "type": "string",
          "optional": false,
          "description": "Form rows: label and hint."
        },
        { "name": "workspaceNameHint", "type": "string", "optional": false },
        { "name": "timeZone", "type": "string", "optional": false },
        { "name": "timeZoneHint", "type": "string", "optional": false },
        { "name": "emailDigests", "type": "string", "optional": false },
        { "name": "emailDigestsHint", "type": "string", "optional": false },
        { "name": "publicProfile", "type": "string", "optional": false },
        { "name": "publicProfileHint", "type": "string", "optional": false },
        {
          "name": "deleteAccount",
          "type": "string",
          "optional": false,
          "description": "Danger zone card (`danger`)."
        },
        { "name": "deleteAccountHint", "type": "string", "optional": false },
        { "name": "delete", "type": "string", "optional": false },
        { "name": "cancel", "type": "string", "optional": false },
        { "name": "save", "type": "string", "optional": false }
      ]
    }
  ]
}
