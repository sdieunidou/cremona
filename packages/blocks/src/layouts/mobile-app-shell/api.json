{
  "component": "MobileAppShell",
  "props": [
    {
      "name": "dark",
      "type": "boolean",
      "optional": true,
      "description": "Render the phone in the dark palette, whatever the page mode.",
      "default": "false"
    },
    {
      "name": "balance",
      "type": "MobileAppShellBalance",
      "optional": true,
      "description": "Balance card.",
      "default": "{…}"
    },
    {
      "name": "transaction",
      "type": "MobileAppShellTransaction",
      "optional": true,
      "description": "Latest transaction row.",
      "default": "{…}"
    },
    {
      "name": "weekTotal",
      "type": "string",
      "optional": true,
      "description": "Pre-formatted total of the weekly activity card.",
      "default": "\"32 runs\""
    },
    {
      "name": "labels",
      "type": "Partial<MobileAppShellLabels>",
      "optional": true,
      "description": "UI text; every key is optional and falls back to the English default."
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "MobileAppShellBalance",
      "props": [
        {
          "name": "value",
          "type": "string",
          "optional": false,
          "description": "Pre-formatted balance."
        },
        {
          "name": "change",
          "type": "string",
          "optional": false,
          "description": "Pre-formatted change."
        },
        {
          "name": "trend",
          "type": "\"up\" | \"down\"",
          "optional": true,
          "description": "Direction of `change` (default: \"down\" when `change` starts with a minus sign)."
        }
      ]
    },
    {
      "name": "MobileAppShellLabels",
      "props": [
        { "name": "greeting", "type": "string", "optional": false },
        {
          "name": "balance",
          "type": "string",
          "optional": false,
          "description": "Caption of the balance card."
        },
        {
          "name": "thisWeek",
          "type": "string",
          "optional": false,
          "description": "Caption of the weekly activity card."
        },
        {
          "name": "home",
          "type": "string",
          "optional": false,
          "description": "Tab bar items; the active one shows its label."
        },
        { "name": "explore", "type": "string", "optional": false },
        { "name": "saved", "type": "string", "optional": false },
        { "name": "profile", "type": "string", "optional": false }
      ]
    },
    {
      "name": "MobileAppShellTransaction",
      "props": [
        { "name": "name", "type": "string", "optional": false },
        { "name": "initials", "type": "string", "optional": false },
        {
          "name": "detail",
          "type": "string",
          "optional": false,
          "description": "Line under the name."
        },
        {
          "name": "amount",
          "type": "string",
          "optional": false,
          "description": "Pre-formatted amount."
        }
      ]
    }
  ]
}
