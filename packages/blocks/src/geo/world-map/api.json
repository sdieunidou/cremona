{
  "component": "WorldMap",
  "props": [
    { "name": "markers", "type": "WorldMapMarker[]", "optional": true, "default": "[…] (7 items)" },
    { "name": "regions", "type": "WorldMapRegion[]", "optional": true, "default": "[]" },
    { "name": "arcs", "type": "boolean", "optional": true, "default": "true" },
    {
      "name": "arcPairs",
      "type": "[number, number][]",
      "optional": true,
      "default": "[…] (6 items)"
    },
    { "name": "labels", "type": "boolean", "optional": true, "default": "false" },
    {
      "name": "density",
      "type": "\"sparse\" | \"normal\" | \"dense\"",
      "optional": true,
      "default": "\"normal\""
    },
    {
      "name": "reveal",
      "type": "\"bloom\" | \"split\" | \"sweep\"",
      "optional": true,
      "default": "\"bloom\""
    },
    { "name": "revealFrom", "type": "number", "optional": true, "default": "0" },
    { "name": "hover", "type": "boolean", "optional": true, "default": "false" },
    { "name": "wrapperClassName", "type": "string", "optional": true },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Play the entrance animation (default false). When false, render the final state.",
      "default": "false"
    },
    {
      "name": "trigger",
      "type": "TriggerMode",
      "optional": true,
      "from": "VisualProps",
      "description": "How the entrance is triggered.",
      "default": "\"inView\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "optional": true,
      "from": "VisualProps",
      "description": "Make the visual fill the box it is given instead of sitting in the gallery preview frame: drops the frame's side padding, stretches on the cross axis and removes the module's `max-w-*` cap. Off by default, so the preview rendering — and every golden — is unchanged.\n\nTurn it on to use a visual as a panel in an app layout, where a centred, capped card gives mismatched widths and edges from one cell to the next.",
      "default": "false"
    },
    { "name": "className", "type": "string", "optional": true, "from": "VisualProps" }
  ],
  "types": [
    {
      "name": "WorldMapMarker",
      "props": [
        { "name": "lat", "type": "number", "optional": false },
        { "name": "lng", "type": "number", "optional": false },
        { "name": "label", "type": "string", "optional": true },
        { "name": "color", "type": "string", "optional": true },
        { "name": "active", "type": "boolean", "optional": true }
      ]
    },
    {
      "name": "WorldMapRegion",
      "props": [
        { "name": "lat", "type": "[number, number]", "optional": false },
        { "name": "lng", "type": "[number, number]", "optional": false },
        { "name": "color", "type": "string", "optional": true }
      ]
    }
  ]
}
