{
  "name": "@cremona/blocks",
  "version": "0.1.0",
  "description": "Cremona visual blocks for React — 160 animated compositions (metrics, charts, AI scenes, components, kits), one entry point per block.",
  "license": "MIT",
  "author": "Sébastien Dieunidou",
  "homepage": "https://github.com/sdieunidou/cremona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdieunidou/cremona.git",
    "directory": "packages/blocks"
  },
  "bugs": {
    "url": "https://github.com/sdieunidou/cremona/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "motion",
    "animation",
    "components",
    "charts",
    "dashboard",
    "design-system",
    "tailwindcss"
  ],
  "type": "module",
  "exports": {
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json",
    "./*": "./src/*/react.tsx"
  },
  "files": [
    "dist",
    "public",
    "catalog.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs && node scripts/copy-media.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cremona/core": "workspace:^",
    "@cremona/react": "workspace:^"
  },
  "peerDependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.47.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./catalog.json": "./catalog.json",
      "./package.json": "./package.json",
      "./*": {
        "types": "./dist/*/react.d.ts",
        "default": "./dist/*/react.js"
      }
    },
    "typesVersions": {
      "*": {
        "catalog.json": [
          "./catalog.json"
        ],
        "package.json": [
          "./package.json"
        ],
        "*": [
          "./dist/*/react.d.ts"
        ]
      }
    }
  }
}
