{
  "name": "cremona",
  "version": "0.1.0",
  "private": true,
  "description": "Cremona — animated visual blocks design system for React & Stimulus, consumable via MCP/Skills.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r --no-bail typecheck",
    "extract": "python3 tools/extract/run_all.py",
    "generate:stimulus": "node tools/generate-stimulus.mjs",
    "validate": "node packages/mcp/scripts/validate.mjs",
    "dev": "pnpm --filter @cremona/gallery dev",
    "gallery:build": "pnpm --filter @cremona/gallery build",
    "mcp": "node packages/mcp/bin/cremona-mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
